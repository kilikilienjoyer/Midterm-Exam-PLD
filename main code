using System;
using System.ComponentModel;
using System.Numerics;
using System.Xml.Serialization;

class MidtermExam
{
    static void Main(string[] args)
    {
        //Project Menu
        string[] foodName = { "Burger", "Fries", "Spaghetti", "Soda", "Iced Tea" };
        double[] foodPrice = { 80.00, 45.00, 99.00, 25.00, 20.00 };
        double total = 0.0;
        bool closeProgram = false;

        do
        {
            Console.WriteLine("Restaurant Name : Main Menu");
            Console.WriteLine("1. View Products");
            Console.WriteLine("2. Place Order");
            Console.WriteLine("3. View Receipt");
            Console.WriteLine("4. Search for a Product");
            Console.WriteLine("5. Sort Products by Price");
            Console.WriteLine("6. Exit");
            Console.WriteLine();

            int chosenOption = Convert.ToInt32(Console.ReadLine());

            switch (chosenOption)
            {
                case 1:
                    Console.Write("Products: ");
                    foreach (string i in foodName)
                    {
                        Console.Write(i + ", ");
                    }
                    Console.Write("\nPrices: ");
                    foreach (double i in foodPrice)
                    {
                        Console.Write(i + ", ");
                    }
                    Console.WriteLine("\n");
                    break;
                case 2:
                    Console.WriteLine("Place Order");
                    bool isDone = false;
                    //string isDone = "no";
                    int amount0 = 0;
                    int amount1 = 0;
                    int amount2 = 0;
                    int amount3 = 0;
                    int amount4 = 0;
                    double order0 = amount0 * foodPrice[0];
                    double order1 = amount1 * foodPrice[1];
                    double order2 = amount1 * foodPrice[2];
                    double order3 = amount1 * foodPrice[3];
                    double order4 = amount1 * foodPrice[4];
                    do
                    {
                        Console.WriteLine("Select Products: ");
                        foreach (string i in foodName)
                        {
                            Console.Write(i + ", ");
                        }
                        string selected = Console.ReadLine();
                        if (selected == foodName[0])
                        {
                            Console.WriteLine(foodName[0] + "s selected, please specify the amount");
                            amount0 = Convert.ToInt32(Console.ReadLine());
                            Console.WriteLine(foodName[0] + "s ordered: " + amount0);
                        }
                        else if (selected == foodName[1])
                        {
                            Console.WriteLine(foodName[1] + " selected, please specify the amount");
                            amount1 = Convert.ToInt32(Console.ReadLine());
                            Console.WriteLine(foodName[1] + " ordered: " + amount1);
                        }
                        else if (selected == foodName[2])
                        {
                            Console.WriteLine(foodName[2] + "s selected, please specify the amount");
                            amount2 = Convert.ToInt32(Console.ReadLine());
                            Console.WriteLine(foodName[2] + "s ordered: " + amount2);
                        }
                        else if (selected == foodName[3])
                        {
                            Console.WriteLine(foodName[3] + "s selected, please specify the amount");
                            amount3 = Convert.ToInt32(Console.ReadLine());
                            Console.WriteLine(foodName[3] + "s ordered: " + amount3);
                        }
                        else if (selected == foodName[4])
                        {
                            Console.WriteLine(foodName[4] + "s selected, please specify the amount");
                            amount4 = Convert.ToInt32(Console.ReadLine());
                            Console.WriteLine(foodName[4] + "s ordered: " + amount4);
                        }
                        else
                        {
                            Console.WriteLine("Error, no valid product selected");
                        }
                        Console.WriteLine("Order Complete?");
                        order0 = amount0 * foodPrice[0];
                        order1 = amount1 * foodPrice[1];
                        order2 = amount1 * foodPrice[2];
                        order3 = amount1 * foodPrice[3];
                        order4 = amount1 * foodPrice[4];
                        total = order0 + order1 + order2 + order3 + order4;
                        isDone = Convert.ToBoolean(Console.ReadLine());
                    }
                    while (isDone != true);
                    break;
                case 3:
                    Console.WriteLine("View Receipt");
                    Console.WriteLine("Total receipt is: " + total);
                    break;
                case 4:
                    Console.WriteLine("Search for Product: ");
                    string search = Console.ReadLine();
                    if (search == foodName[0])
                    {
                        Console.WriteLine(foodName[0]);
                        Console.WriteLine("Price is: " + foodPrice[0]);
                    }
                    else if (search == foodName[1])
                    {
                        Console.WriteLine(foodName[1]);
                        Console.WriteLine("Price is: " + foodPrice[1]);
                    }
                    else if (search == foodName[2])
                    {
                        Console.WriteLine(foodName[2]);
                        Console.WriteLine("Price is: " + foodPrice[2]);
                    }
                    else if (search == foodName[3])
                    {
                        Console.WriteLine(foodName[3]);
                        Console.WriteLine("Price is: " + foodPrice[3]);
                    }
                    else if (search == foodName[4])
                    {
                        Console.WriteLine(foodName[4]);
                        Console.WriteLine("Price is: " + foodPrice[4]);
                    }
                    else
                    {
                        Console.WriteLine("Error");
                    }
                    break;
                case 5:
                    Console.WriteLine("Sort Through Products");
                    Console.WriteLine("Products or Prices?");
                    string sortingChoice = Console.ReadLine();
                    if (sortingChoice is "Products")
                    {
                        Array.Sort(foodName);
                        foreach (string i in foodName)
                        {
                            Console.WriteLine(i);
                        }
                    }
                    else if (sortingChoice is "Prices")
                    {
                        Array.Sort(foodPrice);
                        foreach (double i in foodPrice)
                        {
                            Console.WriteLine(i);
                        }
                    }
                    else
                    {
                        Console.WriteLine("ERROR, Please input either 'Products' or 'Prices'");
                    }
                    break;
                case 6:
                    Console.WriteLine("Exiting Program");
                    Console.WriteLine("Thank you for shopping with us!");
                    closeProgram = true;
                    break;
                default:
                    Console.WriteLine("Error");
                    break;
            }
        }
        while (closeProgram != true);
    }
}
