                string sortingChoice = Console.ReadLine();
                if (sortingChoice is "Products")
                {
                    Array.Sort(foodName);
                    foreach (string i in foodName)
                    {
                        Console.WriteLine(i);
                    }
                }
                else if (sortingChoice is "Prices")
                {
